{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["vite/client"]
  },
  "include": [
    "cpanel-src/**/*.ts",
    "cpanel-src/**/*.tsx",
    "app/page.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx"
  ],
  "exclude": [
    "app/api",
    "app/server",
    "worker",
    "db",
    "dist",
    "cpanel-package",
    "node_modules"
  ]
}
